# ************************************************************
# ************************* REQUIRED *************************
# ************************************************************

# development | production
NODE_ENV=production

# Vercel-only: enables the experimental backend build mode that resolves the
# `@/` import alias. Set on the API project in Vercel Dashboard → Settings →
# Environment Variables (all environments). Not read by the code; not needed
# for local dev.
VERCEL_EXPERIMENTAL_BACKENDS=1

# Secret used for signing JWT auth token
AUTH_SECRET="actual-auth-secret-here"

# URL for connecting to the database.
# Production (Vercel) MUST be Postgres, e.g. from Neon or Supabase:
# DATABASE_URL=postgres://user:password@host:5432/ecommerce?sslmode=require
# Local dev can use Postgres or SQLite:
# DATABASE_URL=postgres://postgres:password@localhost:5432/ecommerce
# DATABASE_URL=sqlite:./database.sqlite
DATABASE_URL=sqlite:./database.sqlite

# Browser origin(s) allowed to call the API (CORS + CSRF allowlist),
# comma-separated, no trailing slash. REQUIRED in production because the UI
# calls the API cross-origin; the server refuses to boot in production
# without it. With a custom domain, use the UI origin, for example:
TRUSTED_ORIGINS=https://myshop.com


# ************************************************************
# ************************* OPTIONAL *************************
# ************************************************************

# SameSite attribute for the auth (`token`) cookie. Allowed: lax | strict | none.
# Defaults to `lax`. Set to `none` when UI and API are on different sites
AUTH_COOKIE_SAMESITE=lax

# Port used by the standalone server (local `npm --prefix server dev`). Defaults to 5000
PORT=5000

# Specifies whether the DB should by synced on boot. Allowed values:
#   safe: default value, creates only the missing tables
#   alter: modifies existing tables (this value has no effect in production)
#   none: doesn't sync
DB_SYNC=safe

# Specifies whether the application should check for empty tables and seed default values.
# In development, it is always checked.
# In production, it can be controlled by:
#   true: seeds the database if needed
#   false: skips checking for empty tables and doesn't seed (default value)
# Generally, you will set it to true for first production deploy and then set it to false before next one.
DB_SEED=false

# Max DB connections per function instance. For functions, keep its value low as functions scale
# horizontally and each instance holds its own pool. Defaults to 2
DB_POOL_MAX=2

# Directory for log files when a log target includes "file".
# Defaults to ./logs. Ignored on Vercel — function filesystem is ephemeral
LOG_DIR=./logs

# Target (console | file | both | none) for app logs
APP_LOGS=console

# Target (console | file | both | none) for request logs
REQ_LOGS=console

# Target (console | file | both | none) for SQL logs
SQL_LOGS=console
