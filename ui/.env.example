# VITE_ prefixed vars are accessible in browser devtools (bundler hardcodes it in client bundle).
# Example: import.meta.env.VITE_BACKEND_URL will be transformed to "http://localhost:5000" in dist,
# and in dev mode, Vite injects a special runtime object for import.meta.env which will include it

# Non-prefixed vars are available only to Node (e.g. inside vite.config.js if you load them with loadEnv('', '', '')), not bundled into frontend.

# Base URL of the backend API. OPTIONAL — leave unset.
# When unset (the default), the frontend uses same-origin relative URLs
# (`/api/...`, `/images/...`), which is correct for the Vercel monolith
# (UI + API on one domain) and for local dev (Vite proxies `/api` to the
# standalone server on :5000).
# Only set this to debug against a remote API, for example:
VITE_BACKEND_URL=https://your-app.vercel.app
